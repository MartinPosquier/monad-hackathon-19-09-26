# Monad Sperm Race — modèle de .env.local. `npm run setup` crée le vrai fichier et génère les clés.

# stub = aucun réseau (démo hors ligne) · testnet = contrat réel sur Monad
CHAIN_MODE=stub
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
EXPLORER_URL=https://testnet.monadvision.com

# Seuil passé au constructeur. Ensuite, sans redéployer : npm run threshold -- 1000
QUALIFY_THRESHOLD=5

LOBBY_SECONDS=45
PRESTART_SECONDS=6
RACE_SIZE=40
RACE_ENGINE=planck
SUBMIT_RESULTS=1

# Écrit par `npm run deploy`
CONTRACT_ADDRESS=
CONTRACT_DEPLOY_BLOCK=

# Générés par `npm run setup` — owner (à alimenter en MON), attestor (signature seule), jeton hôte
DEPLOYER_PRIVATE_KEY=
ATTESTOR_PRIVATE_KEY=
HOST_TOKEN=
