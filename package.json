{
  "name": "monad-sperm-race",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "demo": "next build && next start -p 3100",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "compile": "tsx scripts/compile.ts",
    "setup": "tsx scripts/setup.ts",
    "balance": "tsx scripts/balance.ts",
    "deploy": "tsx scripts/deploy.ts",
    "threshold": "tsx scripts/set-threshold.ts",
    "nonce": "tsx scripts/nonce.ts",
    "verify:fees": "tsx scripts/verify-fees.ts",
    "e2e": "tsx scripts/e2e.ts",
    "simulate": "tsx scripts/simulate.ts",
    "tunnel": "cloudflared tunnel --no-autoupdate --protocol http2 --url http://localhost:3100"
  },
  "dependencies": {
    "next": "16.3.5",
    "planck": "^1.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.186.0",
    "viem": "^2.56.8"
  },
  "devDependencies": {
    "@ethereumjs/block": "^10.1.3",
    "@ethereumjs/common": "^10.1.3",
    "@ethereumjs/tx": "^10.1.3",
    "@ethereumjs/util": "^10.1.3",
    "@ethereumjs/vm": "^10.1.3",
    "@types/node": "^24.13.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "solc": "^0.8.37",
    "tsx": "^4.23.13",
    "typescript": "^5",
